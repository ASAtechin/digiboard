# DigiBoard Backend Production Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection (PRODUCTION)
# Get this from your MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster0.nxz9wpg.mongodb.net/digiboard?retryWrites=true&w=majority&appName=Cluster0

# Frontend Configuration (for CORS)
FRONTEND_URL=https://digiboard.netlify.app

# Optional: JWT Secret (if you add authentication later)
# JWT_SECRET=your-super-secret-jwt-key-here

# Optional: API Rate Limiting
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# Optional: Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Optional: File Upload Configuration
# MAX_FILE_SIZE=10mb
# UPLOAD_DIR=uploads

# Development note: For local development, create a separate .env.development file
# with NODE_ENV=development and local MongoDB connection
