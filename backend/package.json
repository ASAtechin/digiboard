{
  "name": "digiboard-backend",
  "version": "1.0.0",
  "description": "DigiBoard Educational Management System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "offline": "node server-offline.js",
    "dev:offline": "nodemon server-offline.js",
    "seed": "node seedDatabase.js",
    "test": "cross-env NODE_ENV=test jest --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:schedule": "cross-env NODE_ENV=test jest schedule.test.js",
    "test:teachers": "cross-env NODE_ENV=test jest teachers.test.js",
    "test:lectures": "cross-env NODE_ENV=test jest lectures.test.js",
    "test:integration": "cross-env NODE_ENV=test jest integration.test.js"
  },
  "keywords": [
    "education",
    "schedule",
    "management",
    "api"
  ],
  "author": "ASAtechin",
  "license": "ISC",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.10",
    "rate-limiter-flexible": "^7.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true,
    "maxWorkers": 1,
    "setupFilesAfterEnv": ["./tests/setup.js"],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "coverageThreshold": {
      "global": {
        "branches": 5,
        "functions": 10,
        "lines": 20,
        "statements": 20
      }
    },
    "collectCoverageFrom": [
      "routes/**/*.js",
      "models/**/*.js",
      "!**/node_modules/**"
    ]
  }
}
