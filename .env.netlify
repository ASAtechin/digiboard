# Environment Variables for Netlify Functions (if needed)
# Since Netlify hosts static sites, the backend MongoDB connection 
# should be deployed to a backend hosting service like Railway, Render, or Heroku

# For Netlify Functions (if you want to add serverless functions later)
# Set MONGODB_URI in the hosting provider's secret settings. Never commit a real value.
MONGODB_URI=
NODE_ENV=production
